# ==============================================================================
# CONFIGURACION DE BASE DE DATOS Y DESPLIEGUE PERSONAL PAY
# ==============================================================================

# Proveedor de base de datos ('supabase' o 'sqlite')
# En Vercel se debe configurar 'supabase'
DATABASE_PROVIDER=supabase

# Credenciales de tu proyecto en Supabase (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Autenticacion de Google (Google Cloud Console OAuth 2.0)
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# Secreto para sesiones
NEXTAUTH_SECRET=personal-pay-secret-key-32-chars-min
NEXTAUTH_URL=http://localhost:3000
